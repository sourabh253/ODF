# ── Core ─────────────────────────────────────────────────────────────
MONGO_URI=
PORT=5000
JWT_SECRET=
NODE_ENV=production

# Used only by scripts/seedAdmin.js — never stored, never logged
ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Extra origin(s) for production, e.g. your Vercel URL(s), comma-separated
FRONTEND_URL=

# ── Cloudinary (image uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay (test mode) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
